# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cultural_attire?schema=public"
# Supabase Phase B (md/10 §7): the app pool reads DATABASE_URL (use the
# pooler URL, port 6543, for serverless/multi-instance), while migrations
# must use the DIRECT session-mode URL (port 5432) — the transaction pooler
# breaks DDL. DATABASE_SSL=1 forces TLS outside *.supabase.co (Supabase
# hosts always use TLS). DATABASE_POOL_MAX caps pg connections (Supabase
# free tier is small — 5 is a safe prod value).
DIRECT_URL=""
# TLS posture (libpq sslmode semantics): Supabase hosts default to encrypted
# (require) without CA verification — pooler chains + TLS-inspecting networks
# break strict checks while password auth still gates access. Set
# DATABASE_SSL=strict (or ?sslmode=verify-full) for full CA verification.
DATABASE_SSL=""
DATABASE_POOL_MAX="10"

# App port for host-Node deploys (migrate, then `node .next/standalone/server.js`).
APP_PORT="3000"

# Auth
AUTH_SECRET="change-me-in-dev"

# AI providers (server-side only — never expose to frontend)
# AI_PROVIDER: mock (offline, deterministic), openai, or google (Gemini API).
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
IMAGE_API_KEY=""
IMAGE_MODEL="gpt-image-1"
# EMBEDDING_PROVIDER: mock (offline, deterministic unit-norm vectors,
# default) or openai for live text-embedding-3-small semantics ("live" is
# accepted as an alias). Live needs EMBEDDING_API_KEY (falls back to
# AI_API_KEY); backfill via POST /api/admin/embeddings/backfill.
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
# VISION_PROVIDER: mock (offline, deterministic, default) or openai for live
# vision estimates ("live" is accepted as an alias of openai). Live needs a
# key (VISION_API_KEY, falls back to AI_API_KEY) and fails loudly without one.
VISION_PROVIDER="mock"
VISION_API_KEY=""
VISION_MODEL="gpt-4o-mini"
VISION_TIMEOUT_MS="60000"

# Google Gemini (AI Studio / Gemini API). Set AI_PROVIDER / EMBEDDING_PROVIDER
# / VISION_PROVIDER to "google" (alias "gemini") to use these. GOOGLE_API_KEY
# is a single AI Studio key (GEMINI_API_KEY is accepted as a fallback name);
# the provider-specific *_API_KEY vars above win when set. Image generation
# uses the Gemini image model (default gemini-2.5-flash-image); embeddings are
# requested at 1536 dims to match the pgvector column.
GOOGLE_API_KEY=""
GOOGLE_MODEL="gemini-2.5-flash"
GOOGLE_IMAGE_MODEL="gemini-2.5-flash-image"
GOOGLE_VISION_MODEL="gemini-2.5-flash"
GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"
GOOGLE_TIMEOUT_MS="60000"

# Storage (md/10 §8, md/09 §81) — local disk by default; Supabase in prod.
# STORAGE_BACKEND: local (disk under STORAGE_DIR, $0 default) or s3
# (any S3-compatible backend). Production = Supabase Storage via its S3
# protocol endpoint: Supabase dashboard → Storage → S3 configuration gives
# you the endpoint (https://<ref>.storage.supabase.co/storage/v1/s3),
# region, and server-side-only S3 access keys. Keep the bucket PRIVATE —
# reads stay proxied through the session-guarded /api/files route.
STORAGE_BACKEND="local"
STORAGE_URL=""
STORAGE_BUCKET="cultural-attire"
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limits (md/09 §116) — requests per window, per IP (auth) or user (AI)
RATE_LIMIT_AUTH_PER_MIN="30"
RATE_LIMIT_AI_GENERATE_PER_HOUR="10"
RATE_LIMIT_AI_REFINE_PER_HOUR="20"
RATE_LIMIT_VISION_PER_HOUR="20"
# Daily AI spend quotas (md/10 §159) — per user, per calendar day, second
# layer above the hourly rate limits. Generous defaults: demo seeds and
# smoke batteries never trip them. Set 0 to block a kind entirely.
AI_QUOTA_GENERATE_PER_DAY="50"
AI_QUOTA_REFINE_PER_DAY="100"
AI_QUOTA_IMAGE_PER_DAY="50"
# Multi-instance rate limits (md/10 §153): set REDIS_URL to share quotas
# across instances (fixed-window Lua); unset keeps the in-memory limiter.
# Redis failure fails open to memory with a throttled warn log.
REDIS_URL=""

# Error monitoring (md/10 §153): set SENTRY_DSN to ship server errors to
# Sentry (client needs NEXT_PUBLIC_SENTRY_DSN for browser errors). Unset =
# fully inert, SDK never sends. Never commit real DSNs.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Cost engine profile (md/06 §15)
COST_CONTINGENCY_PCT="10"
COST_NEAR_BUDGET_PCT="90"
